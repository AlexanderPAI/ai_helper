# Copy this file to .env and fill in your values.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ai-helper
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# Humor API credentials and meme endpoints
HUMOR_API_API_KEY=
HUMOR_API_RANDOM_URL=https://api.humorapi.com/memes/random
HUMOR_API_SEARCH_URL=https://api.humorapi.com/memes/search
HUMOR_API_TIMEOUT=15
HUMOR_API_USER_AGENT=ai-helper/0.1

# Telegram bot token and comma-separated IDs of allowed group chats.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
TELEGRAM_CALENDAR_DEFAULT_TIMEZONE=Europe/Moscow

# PostgreSQL container and application connection.
POSTGRES_DB=ai_helper
POSTGRES_USER=ai_helper
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ai_helper:change-me@postgres:5432/ai_helper
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
